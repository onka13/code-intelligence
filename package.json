{
  "name": "code-intelligence",
  "version": "0.6.1",
  "private": false,
  "description": "A symbol map, dependency graph and token-budgeted context for any codebase, with one Tree-sitter language pack per language.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onka13/code-intelligence.git"
  },
  "homepage": "https://github.com/onka13/code-intelligence#readme",
  "bugs": {
    "url": "https://github.com/onka13/code-intelligence/issues"
  },
  "keywords": [
    "tree-sitter",
    "ai-agents",
    "code-context",
    "code-map",
    "dependency-graph",
    "static-analysis",
    "llm",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "codeintel": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/packs",
    "packs/*/*.scm",
    "grammars",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "golden:update": "npm run build && node dist/test/updateGolden.js",
    "codeintel": "node dist/src/cli.js"
  },
  "dependencies": {
    "ignore": "7.0.12",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "ajv": "8.20.0",
    "typescript": "5.8.3"
  }
}
